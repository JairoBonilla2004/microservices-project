# =============================================================================
#  Variables de Entorno — master-gateway (Docker Compose)
#
#  Copia este archivo a .env y completa los valores obligatorios antes de
#  ejecutar docker compose up.
#
#  Convención de nomenclatura:
#    - SPRING_DATASOURCE_*   → Spring Boot nativo (sobrescribe YAML)
#    - DB_*, DDL_AUTO, etc.  → Placeholders en application.yml (fallback)
#    - JWT_*, ADMIN_*, etc.  → Propiedades personalizadas
#
#  Para generar un JWT_SECRET seguro:
#      openssl rand -base64 48
#
#  Autores:
#    - Jairo Bonilla
#    - Julio Viche
#    - Reishel Tipán
# =============================================================================

# ===========================================================================
#  OBLIGATORIOS
# ===========================================================================

# JWT Secret — mínimo 32 caracteres (256 bits) para HMAC-SHA256.
JWT_SECRET=

# ===========================================================================
#  Base de datos — PostgreSQL
# ===========================================================================

DB_NAME=master_gateway
DB_USER=postgres
DB_PASSWORD=changeme
DB_PORT=5432

# ===========================================================================
#  API Gateway — Spring Boot
# ===========================================================================

# Puerto del contenedor (mapeo host:contenedor)
API_PORT=8080

# Perfil activo (prod | dev)
SPRING_PROFILES_ACTIVE=prod

# Política DDL (validate | update | create-drop | none)
DDL_AUTO=validate
SHOW_SQL=false

# Modo JWT (direct | asymmetric)
JWT_MODE=direct

# Niveles de logging
#   LOG_LEVEL         → raíz (root)
#   GATEWAY_LOG_LEVEL → paquete ec.edu.espe.master_gateway
LOG_LEVEL=WARN
GATEWAY_LOG_LEVEL=INFO

# Algoritmo de hash de contraseñas (argon2 | bcrypt)
HASH_ALGORITHM=argon2

# Contraseña inicial del usuario boss_admin.
# Si se omite, se genera una aleatoria y se imprime UNA VEZ en los logs.
ADMIN_SEED_PASSWORD=

# Pool de conexiones HikariCP (opcional)
# DB_POOL_SIZE=20
# DB_MIN_IDLE=10

# ===========================================================================
#  Frontend — React + Nginx
# ===========================================================================

FRONT_PORT=80

# URL base de la API (build-time).
# Mismo dominio → "/api"  |  Dominio separado → URL completa
# Ejemplo: VITE_API_URL=https://api.mi-dominio.com
VITE_API_URL=/api
