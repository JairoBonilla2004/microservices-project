# URL base de la API del Master Gateway usada en tiempo de ejecución (build de producción).
# En desarrollo (npm run dev) se puede dejar vacía: se usa el proxy de Vite hacia VITE_API_PROXY_TARGET.
VITE_API_URL=

# Solo para desarrollo local: destino del proxy de Vite para /api (evita CORS en dev).
VITE_API_PROXY_TARGET=http://localhost:8080
