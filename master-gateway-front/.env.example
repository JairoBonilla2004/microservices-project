# =============================================================================
#  Variables de Entorno — master-gateway-front
#
#  Copia este archivo a .env para desarrollo local.
#  En producción, estas variables se inyectan vía Docker build arg o
#  se configuran en el archivo .env raíz del proyecto.
#
#  Autores:
#    - Jairo Bonilla
#    - Julio Viche
#    - Reishel Tipán
# =============================================================================

# ---------------------------------------------------------------------------
#  VITE_API_URL (OBLIGATORIO en producción)
#  URL base de la API del Master Gateway.
#  Se inyecta en tiempo de build. En desarrollo se puede dejar vacía
#  porque Vite usa el proxy configurado hacia VITE_API_PROXY_TARGET.
#  Ejemplo: https://api.mi-dominio.com
# ---------------------------------------------------------------------------
VITE_API_URL=

# ---------------------------------------------------------------------------
#  VITE_API_PROXY_TARGET (SOLO desarrollo)
#  Destino del proxy de Vite para /api (evita CORS en desarrollo local).
#  No tiene efecto en producción.
# ---------------------------------------------------------------------------
VITE_API_PROXY_TARGET=http://localhost:8080
