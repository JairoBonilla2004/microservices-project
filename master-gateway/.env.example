# Base de datos (obligatorio)
DB_URL=jdbc:postgresql://localhost:5432/master_gateway
DB_USER=postgres
DB_PASSWORD=

# JWT (obligatorio) — cadena aleatoria de al menos 32 caracteres (256 bits) para HMAC-SHA256.
# Generar, por ejemplo: openssl rand -base64 48
JWT_SECRET=

# Modo de firma del JWT: "direct" (simétrico HS256) o "asymmetric" (RSA, para validación
# sin comunicación directa con el Master por parte de microservicios hijos).
# JWT_MODE=direct

# Contraseña del usuario administrador semilla (boss_admin), opcional.
# Si se omite, se genera una contraseña aleatoria en el primer arranque y se
# imprime UNA sola vez en los logs de la aplicación (nivel WARN) — cámbiala
# tras el primer login.
ADMIN_SEED_PASSWORD=

# Puerto del servidor (opcional, por defecto 8080)
# PORT=8080

# Nivel de logging raíz (opcional, por defecto INFO)
# LOG_LEVEL=INFO
